@{
    ViewData["Title"] = "Error";
    var errorMessage = TempData["ErrorMessage"] as string;
}
<div class="container text-center mt-5">
    <h1 class="display-4 text-danger">Something Went Wrong</h1>
    <p class="lead">@(errorMessage ?? "An unexpected error occurred while processing your request.")</p>
    <a asp-action="Index" asp-controller="Home" class="btn btn-primary">Back to Home</a>
</div>
